# Database
DATABASE_URL="mysql://user:pass@host:3306/casuals_portal"

# Auth
JWT_SECRET="replace-with-a-long-random-string"

# BioStar 2 TA (Time & Attendance) API — this is what the sync job actually
# pulls punch logs from. It's a separate auth domain from the AC (access
# control) API: login takes the account's login_id (in a field named
# `user_id`) and password directly against this base URL, on a separate port
# (commonly 3002) and a `/tna` path prefix, not `/api`.
BIOSTAR_API_USER="read-only-api-account"
BIOSTAR_API_PASS="its-password"
BIOSTAR_CA_CERT="/path/to/biostar-ca.pem"
BIOSTAR_TA_BASE_URL="https://biostar-host:3002/tna"

# Exact (case-insensitive) BioStar user_group name the sync scopes down to —
# this is what makes it "Casuals only" rather than every BioStar user.
BIOSTAR_CASUALS_GROUP_NAME="CASUALS"

# DEV ONLY — bypasses TLS cert validation for BioStar calls (some on-prem
# servers ship certs that fail Node's purpose check even with the right CA).
# Do not set this in production; use BIOSTAR_CA_CERT instead.
# BIOSTAR_SKIP_TLS_VERIFY="true"

# How many days back every sync run re-checks, regardless of what's already
# synced (rather than walking forward from the latest known punch) — catches
# punches stamped earlier than the last-seen record, e.g. overnight/night-
# shift punches arriving out of order. Also used to re-run the shift summary
# computation over the same window after every sync.
SYNC_LOOKBACK_DAYS=14

# Server
PORT=4000
# Production: listen on localhost only, behind IIS (see README).
# HOST=127.0.0.1
