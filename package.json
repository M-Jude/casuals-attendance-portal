{
  "name": "casuals-attendance-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Subcontractor-facing attendance reporting portal for UCAA Casuals, synced from BioStar 2.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "vite",
    "sync": "node -e \"require('./sync/attendanceSync').syncAttendance().then(() => process.exit(0))\"",
    "seed:user": "node scripts/seedPortalUser.js",
    "seed:shifts": "node scripts/seedShifts.js"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "axios": "^1.7.7",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "json2csv": "^5.0.7",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "prisma": "^5.18.0",
    "vite": "^5.4.0"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "bcrypt@5.1.1": true,
    "prisma@5.22.0": true,
    "esbuild@0.21.5": true
  }
}
