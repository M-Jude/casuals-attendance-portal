generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model CasualWorker {
  id                Int      @id @default(autoincrement())
  biostarUserId     String   @unique
  name              String
  subcontractorName String   @default("Subcontractor A") // seam for future multi-tenant support
  startDate         DateTime
  status            String   @default("active") // active | inactive

  attendanceLogs    AttendanceLog[]
  shiftAssignments  ShiftAssignment[]
  dailySummaries    DailyAttendanceSummary[]
}

model AttendanceLog {
  id             Int      @id @default(autoincrement())
  casualWorkerId Int
  worker         CasualWorker @relation(fields: [casualWorkerId], references: [id])
  biostarEventId String   @unique // prevents duplicate rows on repeated sync runs
  eventType      String   // check-in | check-out | other
  timestamp      DateTime
  rawPayload     Json?    // raw BioStar event, kept for debugging/audit
  syncedAt       DateTime @default(now())

  @@index([casualWorkerId, timestamp])
}

model PortalUser {
  id                Int      @id @default(autoincrement())
  email             String   @unique
  passwordHash      String
  subcontractorName String   @default("Subcontractor A")
  createdAt         DateTime @default(now())
}

// Fixed shift definitions. Only two rows expected: Day and Night.
// Night is "overnight" because endTime < startTime.
model Shift {
  id           Int      @id @default(autoincrement())
  name         String   @unique // "Day" | "Night"
  startTime    String   // "HH:mm", business-local (Africa/Kampala)
  endTime      String   // "HH:mm", business-local
  graceMinutes Int      @default(15) // tolerance before a check-in counts as "late"

  assignments        ShiftAssignment[]
  summaries          DailyAttendanceSummary[]
  rosteredSummaries  DailyAttendanceSummary[] @relation("RosteredShiftSummaries")
}

// The uploaded shift roster — one row per worker per date, naming which
// shift they were scheduled for. Populated by POST /api/shifts/roster/upload
// (sync/shiftRoster.js), not hand-maintained. `date` is the shift's anchor
// date: the calendar day the shift STARTS (for Night, that's the evening
// date, not the following morning — same convention as
// DailyAttendanceSummary.date). This is now the authoritative source for
// "who was expected on what shift" — see sync/computeDailySummaries.js,
// which cross-references it to detect no-shows and roster/actual mismatches,
// while still deriving check-in/check-out times from real punches.
model ShiftAssignment {
  id             Int      @id @default(autoincrement())
  casualWorkerId Int
  worker         CasualWorker @relation(fields: [casualWorkerId], references: [id])
  date           DateTime     // date-only, stored at UTC midnight
  shiftId        Int
  shift          Shift        @relation(fields: [shiftId], references: [id])
  uploadedAt     DateTime @default(now())

  @@unique([casualWorkerId, date])
}

// One computed row per worker per shift instance, derived from raw punches
// classified by time-of-day (see sync/computeDailySummaries.js). This is
// what the dashboard should read — never raw AttendanceLog rows directly.
model DailyAttendanceSummary {
  id                 Int      @id @default(autoincrement())
  casualWorkerId     Int
  worker             CasualWorker @relation(fields: [casualWorkerId], references: [id])
  date               DateTime     // the shift's anchor date
  shiftId            Int          // the shift punches were actually matched against
  shift              Shift        @relation(fields: [shiftId], references: [id])
  rosteredShiftId    Int?         // the shift ShiftAssignment says they were expected on, if any — null when this date/worker has no roster entry; differs from shiftId when the worker punched under a different shift than rostered
  rosteredShift      Shift?       @relation("RosteredShiftSummaries", fields: [rosteredShiftId], references: [id])
  checkIn            DateTime?
  checkOut           DateTime?
  hoursWorked        Float?       // informational only — no overtime logic applied
  status             String       // 'early' | 'on-time' | 'late' | 'no-checkout' | 'no-show'
  hasMultiplePunches Boolean  @default(false) // >1 check-in or check-out in this shift — worth a manual glance, since FILO can't tell noise from a real gap
  earlyCheckOut      Boolean  @default(false) // checked out more than graceMinutes before shift end — independent of `status`, which already tracks check-in timing
  computedAt         DateTime @default(now())

  @@unique([casualWorkerId, date])
}
